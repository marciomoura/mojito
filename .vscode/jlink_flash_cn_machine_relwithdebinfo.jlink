// JLink script to flash STM32F407ZG CN Machine-Side RelWithDebInfo build
// Reset and halt the target
r
halt
// Erase flash
erase
// Load the ELF file
loadfile build-embedded-cn-machine/bin/RelWithDebInfo/yeet_embedded_app_machine.elf
// Verify programming
verifybin build-embedded-cn-machine/bin/RelWithDebInfo/yeet_embedded_app_machine.elf 0x08000000
// Reset and run
r
go
// Exit JLink
qc
