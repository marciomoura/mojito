# Common flags
common --color=yes

# Use C++20 for all builds
# Default to -std=c++20 for Unix-like systems (gcc, clang)
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Use /std:c++20 when building with MSVC on Windows
# Note: Bazel typically detects the compiler, but you can target it via --per_file_copt or platform-specific flags.
# To keep it simple and clean, let's use the standard feature-based flag instead of raw copt if possible,
# or target it directly to the windows platform.
build:windows --cxxopt=/std:c++20
build:windows --host_cxxopt=/std:c++20

# Disable the common warning about -std=c++20 for MSVC if it leaks
# (alternatively we can use --per_file_copt, but this is cleaner for local dev)
# We will use the 'common' way of splitting flags for Windows.

# Show more information during the build
# build --verbose_failures
